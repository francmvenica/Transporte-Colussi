---
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = SITE.description } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

// Canonical: siempre derivado de SITE.url (el dominio final), nunca del base path
// de GitHub Pages. Se le saca el prefijo de base a Astro.url.pathname antes de
// combinarlo, para que /historia bajo GH Pages siga resolviendo a
// https://www.transportecolussi.com.ar/historia y no a la ruta con base incluido.
// BASE_URL puede venir con o sin slash final según cómo se declaró `base` en
// astro.config.mjs — se normaliza a mano para no terminar con "//" duplicado
// (eso rompe `new URL`, que interpreta "//" como URL protocol-relative).
const basePath = import.meta.env.BASE_URL;
let cleanPath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname;
if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
const canonicalURL = new URL(cleanPath, SITE.url).toString();
const ogImageURL = `${SITE.url}/images/og-image.png`;

// JSON-LD (schema.org): Organization + 2 LocalBusiness (Casa Central / CDNoreste)
// subordinados via parentOrganization. Generado a partir de SITE para no duplicar
// datos a mano.
//
// taxID, legalName y foundingDate: CONFIRMADOS por el cliente el 27/07 (venían
// omitidos a propósito hasta esa fecha). Importan porque el taxID y la dirección
// exacta son la señal más fuerte para desambiguar la entidad: hay tres "Colussi"
// homónimos (Gálvez con otro CUIT, General Pico de pasajeros, y varias en Brasil)
// que los motores generativos venían fusionando.
//
// Dirección de Casa Central CORREGIDA 27/07: streetAddress pasa a 'Calle 7 351'
// (reemplaza a 'Ruta Nacional 11 Km 814', que era un dato equivocado del brief
// original). El postalCode 3574 no cambia: es el de la localidad, no de la calle.
//
// geo: sigue OMITIDO. Las coordenadas que había (-28.938237,-59.561470) estaban
// puestas para la dirección vieja y quedaron desactualizadas con el cambio de
// sede. NO inventar coordenadas nuevas — falta geolocalizar Calle 7 351,
// Guadalupe Norte contra Google Maps.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#empresa`,
      name: SITE.name,
      legalName: 'COLUSSI S.A.', // confirmado por el cliente 27/07
      description: SITE.description,
      url: SITE.url,
      logo: `${SITE.url}/images/logo.png`,
      image: ogImageURL,
      email: SITE.contact.email,
      telephone: SITE.contact.phoneRaw,
      taxID: '30-71137821-5', // confirmado por el cliente 27/07
      // 2000 → 2026 son 26 años. No redondear al reutilizar este dato en texto visible.
      foundingDate: '2000', // confirmado por el cliente 27/07
      areaServed: [
        { '@type': 'State', name: 'Chaco' },
        { '@type': 'State', name: 'Formosa' },
        { '@type': 'State', name: 'Corrientes' },
        { '@type': 'State', name: 'Misiones' },
        { '@type': 'State', name: 'Santa Fe' },
        { '@type': 'Country', name: 'Brasil' },
        { '@type': 'Country', name: 'Paraguay' },
      ],
      knowsAbout: [
        'Transporte de cargas generales',
        'Transporte de contenedores',
        'Logística y distribución en el NEA',
        'Transporte internacional al Mercosur',
        'Semirremolques curtain sider',
      ],
      sameAs: [SITE.social.facebook],
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${SITE.url}/#casa-central`,
      name: `${SITE.name} - Casa Central`,
      parentOrganization: { '@id': `${SITE.url}/#empresa` },
      telephone: SITE.sedes[0].phoneRaw,
      email: SITE.sedes[0].email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle 7 351',
        addressLocality: 'Guadalupe Norte',
        addressRegion: 'Santa Fe',
        postalCode: '3574',
        addressCountry: 'AR',
      },
      // geo: OMITIDO — las coordenadas viejas correspondían a "Ruta 11 Km 814" y
      // no son válidas para Calle 7 351. NO inventar coordenadas nuevas; pendiente
      // de geolocalizar la dirección real. Ver comentario de maps.embedUrl en site.ts.
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${SITE.url}/#cd-noreste`,
      name: `${SITE.name} - Centro de Distribución Noreste (CDNoreste)`,
      parentOrganization: { '@id': `${SITE.url}/#empresa` },
      telephone: SITE.sedes[1].phoneRaw,
      email: SITE.sedes[1].email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle 31 N° 770',
        addressLocality: 'Fontana',
        addressRegion: 'Chaco',
        addressCountry: 'AR',
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${basePath}${basePath.endsWith('/') ? '' : '/'}favicon.svg`} />

    <!-- Fonts: Archivo (Omnibus-Type), manual de marca 27/07. Reemplaza a Inter.
         Roman: rango variable wght 400-800 / wdth 75-108% (los 4 roles de marca
         viven en ese rectángulo, ver global.css). Itálica: PIN a un solo punto
         exacto (wght 800 / wdth 100%, lo único que pide "Itálica de marca") en
         vez de rango — medido: pinear el punto baja ese archivo de ~99 KB a
         ~15,6 KB (-84%). El rango de roman, en cambio, no se pudo achicar más
         ahí: Google sirve el mismo binario tanto si se pide 400-800/75-108 como
         si se pide el rango completo 100-900/62-125 (probado con curl antes de
         cerrar esta URL) — la ganancia real de peso está toda en la itálica. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,75..108,400..800;1,100,800&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
  </head>
  <body class="bg-white antialiased">
    <slot />
  </body>
</html>
