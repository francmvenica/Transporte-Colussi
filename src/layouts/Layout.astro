---
import '../styles/global.css';
import { SITE } from '../config/site';
import { SERVICES } from '../config/services';
import { SECTORS } from '../config/clients';
import { CORRIDORS } from '../config/corridors';

interface Props {
  title?: string;
  description?: string;
  /**
   * JSON-LD extra de la página, emitido en un <script> aparte del schema de la
   * empresa. Para tipos que describen la PÁGINA (AboutPage, FAQPage), no para
   * sumarle campos al Organization: eso va en el `@graph` de acá abajo, que es
   * global al sitio y se genera una sola vez.
   */
  schema?: Record<string, unknown>;
}

const { title = SITE.name, description = SITE.description, schema } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

// Canonical: siempre derivado de SITE.url (el dominio final), nunca del base path
// de GitHub Pages. Se le saca el prefijo de base a Astro.url.pathname antes de
// combinarlo, para que /historia bajo GH Pages siga resolviendo a
// https://www.transportecolussi.com.ar/historia y no a la ruta con base incluido.
// BASE_URL puede venir con o sin slash final según cómo se declaró `base` en
// astro.config.mjs — se normaliza a mano para no terminar con "//" duplicado
// (eso rompe `new URL`, que interpreta "//" como URL protocol-relative).
const basePath = import.meta.env.BASE_URL;
let cleanPath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname;
if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
const canonicalURL = new URL(cleanPath, SITE.url).toString();
const ogImageURL = `${SITE.url}/images/og-image.png`;

// JSON-LD (schema.org): Organization + 2 LocalBusiness (Casa Central / CDNoreste)
// subordinados via parentOrganization. Generado a partir de SITE para no duplicar
// datos a mano.
//
// taxID, legalName y foundingDate: CONFIRMADOS por el cliente el 27/07 (venían
// omitidos a propósito hasta esa fecha). Importan porque el taxID y la dirección
// exacta son la señal más fuerte para desambiguar la entidad: hay tres "Colussi"
// homónimos (Gálvez con otro CUIT, General Pico de pasajeros, y varias en Brasil)
// que los motores generativos venían fusionando.
//
// Dirección de Casa Central CORREGIDA 27/07: streetAddress pasa a 'Calle 7 351'
// (reemplaza a 'Ruta Nacional 11 Km 814', que era un dato equivocado del brief
// original). El postalCode 3574 no cambia: es el de la localidad, no de la calle.
//
// geo: AGREGADO el 31/07, con la coordenada de Calle 7 351 geolocalizada contra
// Nominatim. La nota anterior decía que las coordenadas que había eran "de la
// dirección vieja" y **era falso**: el reverse geocoding las ubica en Calle 7
// nº 344, a 41 metros de la sede. El pendiente nació de suponer en vez de
// medir, se copió a tres archivos y sobrevivió tres días. **Solo estaba mal el
// pin del mapa Leaflet, que caía 10 km al oeste, en Avellaneda.**
//
// Se declara geo SOLO en la casa central. El CD de Fontana sigue sin geo: la
// altura de Calle 31 nº 770 no resuelve en Nominatim y acá no se inventa.
// ---------------------------------------------------------------------------
// areaServed A NIVEL CIUDAD (27/08), DERIVADO DE `corridors.ts`.
//
// POR QUÉ EXISTE: el 27/08 las localidades del mapa bajaron a los chips de la
// sección de corredores. Un chip es un nombre suelto, sin verbo, así que para
// una búsqueda tipo "transporte a San Vicente" pesa menos que el mismo nombre
// dentro de una oración. Franco eligió chips y no oraciones, y ESTO es lo que
// compensa esa elección: `areaServed` es el campo estándar donde los motores
// esperan encontrar la cobertura, y no ocupa lugar en pantalla.
//
// ⚠️ NO ES TEXTO OCULTO, y la diferencia no es de matiz. Se evaluó poner el
// texto escondido con CSS y se descartó por dos motivos, en este orden:
//   1. NO FUNCIONA: los crawlers de IA (ChatGPT, Perplexity, Claude con
//      búsqueda, AI Overviews) descartan el contenido oculto antes de
//      indexarlo. El esfuerzo no compra nada.
//   2. Además es penalizable: "hidden text and links" está en las políticas
//      de spam de Google Search, ampliadas en mayo de 2026 para cubrir la
//      manipulación de las respuestas de IA.
// El dato estructurado es legítimo porque declara en un campo estándar algo
// que la página YA dice a la vista. Si algún día los chips salen de la
// sección, esto se va con ellos.
//
// 🔑 SE IMPORTA, NO SE COPIA, y es el mismo criterio que ya usan SECTORS y
// SERVICES acá abajo: así el invariante "el schema no afirma lo que la página
// no afirma" no depende de que alguien se acuerde de actualizar dos archivos.
// Agregar una ciudad a `corridors.ts` la publica en los dos lados.
//
// 🔴 LA PROVINCIA NO ES DECORACIÓN: es lo que desambigua. Esta empresa tiene
// tres homónimos disputándole la identidad, y varias de las ciudades nuevas se
// repiten por todo el país (San Pedro está en Buenos Aires, Jujuy y Misiones;
// Mercedes en Corrientes, Buenos Aires y San Luis; San Vicente en varias). Un
// `{ name: 'Mercedes' }` a secas siembra la ambigüedad que el resto de este
// schema viene a resolver, así que cada ciudad va con su `containedInPlace`.
const PROVINCIA_POR_CORREDOR: Record<string, string> = {
  'Buenos Aires – Formosa': 'Formosa',
  'Buenos Aires – Chaco': 'Chaco',
  'Buenos Aires – Santa Fe': 'Santa Fe',
  'Buenos Aires – Misiones': 'Misiones',
  'Buenos Aires – Corrientes': 'Corrientes',
  // El corredor internacional no mapea a una provincia a propósito: sus
  // ciudades o ya entraron por su corredor nacional (Clorinda por Formosa,
  // Paso de los Libres por Corrientes) o son extranjeras y caen en el mapa
  // de abajo.
};

// Ciudades que NO pertenecen a la provincia de su corredor. Asunción vive en
// el corredor Formosa y Uruguaiana en el internacional, así que derivarlas del
// título del corredor las pondría en la provincia equivocada.
const PAIS_POR_CIUDAD: Record<string, string> = {
  Asunción: 'Paraguay',
  Uruguaiana: 'Brasil',
};

const ciudadesServidas = (() => {
  const vistas = new Set<string>();
  const salida: Record<string, unknown>[] = [];
  for (const corredor of CORRIDORS) {
    const provincia = PROVINCIA_POR_CORREDOR[corredor.title];
    for (const entrada of corredor.cities) {
      // Los chips del corredor internacional vienen como "Clorinda → Paraguay":
      // se corta en la flecha y queda el nombre de la ciudad.
      const nombre = entrada.split('→')[0].trim();
      if (vistas.has(nombre)) continue;
      vistas.add(nombre);

      const pais = PAIS_POR_CIUDAD[nombre];
      if (pais) {
        salida.push({
          '@type': 'City',
          name: nombre,
          containedInPlace: { '@type': 'Country', name: pais },
        });
      } else if (provincia) {
        salida.push({
          '@type': 'City',
          name: nombre,
          containedInPlace: {
            '@type': 'State',
            name: provincia,
            containedInPlace: { '@type': 'Country', name: 'Argentina' },
          },
        });
      } else {
        // ⚠️ SIN PROVINCIA NI PAÍS CONOCIDO. Se emite igual, para que el dato
        // no se pierda en silencio, pero SIN desambiguar. Si aparece una
        // ciudad acá, registrala arriba: es el caso que el schema resuelve
        // peor. Hoy no cae ninguna.
        salida.push({ '@type': 'City', name: nombre });
      }
    }
  }
  return salida;
})();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#empresa`,
      name: SITE.name,
      legalName: 'COLUSSI S.A.', // confirmado por el cliente 27/07
      description: SITE.description,
      url: SITE.url,
      logo: `${SITE.url}/images/logo.png`,
      image: ogImageURL,
      email: SITE.contact.email,
      telephone: SITE.contact.phoneRaw,
      taxID: '30-71137821-5', // confirmado por el cliente 27/07
      // 🟢 `foundingDate` REPUESTO el 10/08, después de once días afuera.
      //
      // Se había eliminado el 29/07 con este criterio, que sigue valiendo: **si
      // no se afirma en la página, tampoco puede afirmarse acá, y menos acá.**
      // El JSON-LD es la capa que define la identidad de la empresa ante los
      // buscadores, y esta empresa tiene tres homónimos contaminándole los
      // resultados, así que un dato dudoso en el schema hace lo contrario de lo
      // que vinimos a resolver. Estaba como '2000' "confirmado por el cliente"
      // pero Franco puso la fecha en duda, y salió del sitio entero.
      //
      // Lo que cambió no es el criterio: es que **ahora el año está escrito en
      // la página**. El texto de /historia, que redactó Juan Manuel Colussi y
      // mandó el 10/08, abre con "Todo empezó en el año 2000". Fuente correcta,
      // por escrito, y Franco lo dio por bueno ese día. Cierra consigo mismo
      // con el "+25 años" de stats.ts (2026 − 2000 = 26).
      //
      // ⚠️ Si alguna vez sale el año del texto de /historia, este campo se va
      // con él. La regla es que el schema no afirme lo que la página no afirma.
      foundingDate: '2000',
      // Las provincias y los países se declaran a mano porque son el alcance
      // que el sitio afirma en prosa (hero, servicios, FAQ). Las CIUDADES se
      // importan de `corridors.ts` — ver el bloque de arriba.
      areaServed: [
        { '@type': 'State', name: 'Chaco' },
        { '@type': 'State', name: 'Formosa' },
        { '@type': 'State', name: 'Corrientes' },
        { '@type': 'State', name: 'Misiones' },
        { '@type': 'State', name: 'Santa Fe' },
        { '@type': 'Country', name: 'Brasil' },
        { '@type': 'Country', name: 'Paraguay' },
        ...ciudadesServidas,
      ],
      // Las industrias (SECTORS) se suman el 08/08 IMPORTADAS de clients.ts, no
      // copiadas a mano: es legítimo declararlas acá SOLO porque siguen
      // escritas en la página (bajaron al <details> de Clientes, pero no
      // desaparecieron — el pliegue es CSS, los crawlers lo leen igual). El
      // schema no puede afirmar lo que la página no afirma; importar en vez de
      // copiar hace que ese invariante no dependa de que alguien se acuerde.
      knowsAbout: [
        'Transporte de cargas generales',
        'Transporte de contenedores',
        'Logística y distribución en el NEA',
        'Transporte internacional al Mercosur',
        'Semirremolques curtain sider',
        ...SECTORS,
      ],
      // Catálogo de servicios estructurado (31/07). Declara los 4 servicios con
      // el MISMO título que muestra la página — no una versión "mejorada" — para
      // que el vocabulario por el que buscan a la empresa (contenedores,
      // logística NEA, internacional) exista también en la capa que leen los
      // buscadores, y no solo dentro de un `<details>` plegado.
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de Transporte Colussi',
        itemListElement: SERVICES.map((servicio) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: servicio.title,
            description: servicio.summary,
            provider: { '@id': `${SITE.url}/#empresa` },
            areaServed: { '@type': 'Country', name: 'Argentina' },
          },
        })),
      },
      sameAs: [SITE.social.facebook],
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${SITE.url}/#casa-central`,
      name: `${SITE.name} - Oficina Central`,
      parentOrganization: { '@id': `${SITE.url}/#empresa` },
      telephone: SITE.sedes[0].phoneRaw,
      email: SITE.sedes[0].email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle 7 351',
        addressLocality: 'Guadalupe Norte',
        addressRegion: 'Santa Fe',
        postalCode: '3574',
        addressCountry: 'AR',
      },
      // geo VERIFICADO el 31/07 contra Nominatim: Calle 7 351, Guadalupe Norte.
      // Estuvo omitido tres días por un pendiente que resultó falso — las
      // coordenadas que había caían a 41 m de la sede, o sea siempre fueron
      // buenas. Declararlo importa acá más que en un sitio cualquiera: con tres
      // homónimos disputándole la identidad, la posición es de los desempates
      // más fuertes que se le puede dar a un buscador.
      geo: {
        '@type': 'GeoCoordinates',
        latitude: -28.938012,
        longitude: -59.561138,
      },
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${SITE.url}/#cd-noreste`,
      name: `${SITE.name} - Centro de Distribución NEA (CD NEA)`,
      parentOrganization: { '@id': `${SITE.url}/#empresa` },
      telephone: SITE.sedes[1].phoneRaw,
      email: SITE.sedes[1].email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle 31 N° 770',
        addressLocality: 'Fontana',
        addressRegion: 'Chaco',
        addressCountry: 'AR',
      },
    },
  ],
};

// Nota interna (no publicar en el HTML) — bloque de <link> de Fonts:
//
// DOS familias, un solo request (Google Fonts acepta varios `family=` en la
// misma URL; dos <link> serían dos round-trips para nada).
//
// ARCHIVO (Omnibus-Type) — roles Texto y Datos. Roman variable wght 400-800 /
// wdth 75-100%. Dos cambios el 30/07, cuando los titulares pasaron a Chivo:
//   · Se DEJÓ DE PEDIR LA ITÁLICA. Era exclusiva del rol "Itálica de marca",
//     que ahora es Chivo. Deja de bajar un archivo de 16.016 bytes (medido).
//   · El tope de wdth bajó de 108% a 100%: el 108 lo usaba solo el Display.
//     No cambia un byte —Google sirve el mismo binario para cualquier rango,
//     verificado con curl— pero deja declarado lo que el sitio realmente usa.
//
// CHIVO (Omnibus-Type, hermana de Archivo) — roles Display e Itálica de marca,
// los dos en 900. Se pide PINEADO a `0,900;1,900` en vez de un rango: Chivo no
// tiene eje de ancho y no se usa ningún otro peso, así que Google devuelve dos
// woff2 estáticos chicos en lugar del variable completo. Medido sobre el
// subset latin: 13.972 bytes el roman + 14.912 la itálica.
//
// BALANCE NETO DEL CAMBIO: +13.972 +14.912 -16.016 = **+12.868 bytes** en
// latin. Dos familias cuestan menos de 13 KB extra porque los dos archivos
// que entran están pineados y el que sale era un variable.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href={`${basePath}${basePath.endsWith('/') ? '' : '/'}favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..800&family=Chivo:ital,wght@0,900;1,900&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body class="bg-neutral-100 antialiased">
    <slot />
  </body>
</html>
