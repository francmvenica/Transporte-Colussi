---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Stats from '../components/Stats.astro';
import RRHH from '../components/RRHH.astro';
import Fleet from '../components/Fleet.astro';
import Sustainability from '../components/Sustainability.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Corridors from '../components/Corridors.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

// Notas internas (no publicar en el HTML):
//
// El orden de <main> sigue el embudo B2B: captar (Hero) -> validar (SocialProof
// + Stats) -> informar (Services + cobertura) -> demostrar (Fleet +
// Sustainability) -> convertir (FAQ + Contact).
//
// Dos pares que NO conviene separar al reordenar:
// - Fleet y Sustainability: son el mismo tema (con que equipos trabajan y que
//   impacto tienen). Sustainability es donde vive el argumento que pidio
//   Romualdo, "a igualdad de tarifa, desempata"; suelto a mitad del sitio se
//   descuelga.
// - SocialProof y Stats: los numeros son prueba, no historia. Antes estaban
//   entre About y RRHH, que es donde el lector ya decidio si sigue leyendo.
//
// Si se cambia este orden, revisar SITE.nav en config/site.ts: el menu del
// header se arma de ahi y su orden tiene que seguir al de la pagina.
---

<Layout title="Transporte de cargas Buenos Aires–NEA">
  <Header />
  <main>
    <Hero />
    <SocialProof />
    <Stats />
    <Services />
    <CoverageMap />
    <Corridors />
    <Fleet />
    <Sustainability />
    <About />
    <RRHH />
    <FAQ />
    <Contact />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
