---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE } from '../config/site';

// BASE_URL puede venir sin slash final (p. ej. "/Transporte-Colussi") — se normaliza
// para que `${base}${href}` nunca pegue el path con lo que sigue.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<Layout
  title="Nuestra Historia"
  description="Conocé la historia de Transporte Colussi, empresa de transporte de cargas con casa central en Guadalupe Norte (Santa Fe) y centro de distribución en Fontana (Chaco)."
>
  <Header />
  <main>
    <section class="pt-36 pb-12 bg-neutral-50 border-b border-neutral-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="text-sm text-neutral-500 mb-6" aria-label="Breadcrumb">
          <a href={base} class="hover:text-brand-red transition-colors">Inicio</a>
          <span class="mx-2">/</span>
          <span class="text-neutral-800 font-medium">Nuestra Historia</span>
        </nav>

        <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">{SITE.name}</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-neutral-900">Nuestra Historia</h1>
      </div>
    </section>

    <section class="py-20 lg:py-28 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* PENDIENTE: texto de Nuestra Historia — lo redacta Juan Manuel */}
        <div class="text-center border border-dashed border-neutral-300 rounded-2xl py-16 px-6">
          <div class="w-14 h-14 bg-brand-red-light rounded-2xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-7 h-7 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a5.25 5.25 0 016.775-5.025.75.75 0 01.313 1.248l-3.32 3.319c.063.475.276.934.641 1.299.365.365.824.578 1.3.64l3.318-3.319a.75.75 0 011.248.313 5.25 5.25 0 01-5.472 6.756c-1.018-.086-1.87.1-2.309.634L7.344 21.3A3.298 3.298 0 112.7 16.657l8.684-7.151c.533-.44.72-1.291.634-2.309A5.342 5.342 0 0112 6.75z" />
            </svg>
          </div>
          <p class="text-lg text-neutral-600 max-w-xl mx-auto">
            Estamos escribiendo esta sección. Muy pronto vas a poder conocer la historia completa de {SITE.name}.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
