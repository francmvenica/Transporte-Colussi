---
import { Image } from 'astro:assets';
import { IMAGES } from '../config/assets';
import { FLEET_SPECS } from '../config/fleet';
import {
  UNIT_TABS,
  MAINTENANCE_COPY,
  TRAFFIC_COPY,
  TRAFFIC_PHOTO_PENDING,
} from '../config/units-tabs';

// Nota interna (no publicar en el HTML):
//
// Las tarjetas de specs usan el MISMO lenguaje que las del mapa de cobertura y
// las de Servicios (unificado el 28/07): fondo blanco, borde suave, punto rojo
// a la izquierda, título arriba y valor debajo. Antes eran centradas, con el
// label en rojo y mayúsculas — un cuarto estilo para la misma idea. Si se toca
// una de las tres, tocar las otras dos: el valor está en que sean iguales.
//
// El VALOR de cada spec lleva `font-data` (Archivo condensado 75% + cifras
// tabulares) desde el 30/07: es el caso de manual del rol Datos — pallets,
// metros, CV y años de antigüedad. El LABEL no lo lleva: es texto, no dato.
//
// 🔴 LA GALERÍA NO LLEVA TÍTULOS SOBRE LAS FOTOS (pedido de Franco, 31/07).
// Cada tarjeta mostraba un texto al pasar el mouse ("Flota propia", "En ruta")
// sobre un degradado oscuro. Se eliminaron los dos: el degradado existía solo
// para dar contraste a ese texto, así que sin texto no tenía función. Queda el
// zoom del hover, que sí aporta. La descripción de cada foto vive en su `alt`
// —que es lo que leen los buscadores y los lectores de pantalla—, no en la UI.
// Si alguien propone devolver los títulos, esto se decidió mirando el sitio.
//
// La galería son 9 fotos y el grid es de 3 columnas: cierra en 3 filas exactas.
// Agregar o sacar una deja la última fila coja — si cambia la cantidad, revisar.
//
// 🔴 GRILLA DE SPECS: 4 → 5 TARJETAS EL 08/08 (entra "Mantenimiento
// Preventivo", ver fleet.ts). La tarjeta EN SÍ no se tocó — sigue el único
// estilo unificado el 28/07 (fondo blanco, borde suave, punto rojo, valor en
// font-data) — solo el wrapper del grid, porque 5 no divide parejo en 4
// columnas. Pasa a `lg:grid-cols-5` (una sola fila en desktop, sin huecos) y
// se mantiene `sm:grid-cols-2` en tablet — ahí sí queda una tarjeta sola en la
// tercera fila (5 = 2+2+1), aceptado: es un rango de viewport angosto y no
// hay forma de repartir 5 en 2 columnas sin que sobre una.
//
// ─────────────────────────────────────────────────────────────────────────────
// 🆕 PESTAÑAS (27/08). Aprobadas por Romualdo el 11/08. Textos y decisiones de
// contenido en `config/units-tabs.ts` — ahí está por qué el taller no se llama
// "nuestro" y por qué el lavado habla del equipo y no del hábito.
//
// 🔴 LAS SPECS QUEDAN FUERA DE LAS PESTAÑAS, A PROPÓSITO. Describen toda la
// sección, no una solapa: meterlas adentro de "Flota" desharía la decisión del
// 08/08 que las llevó de 4 a 5 (la 5ª es justamente Mantenimiento Preventivo, y
// vive ahí porque el cliente pidió que el dato estuviera a la vista).
//
// 🔴 VANILLA JS Y NO UNA ISLA REACT. La integración de React está instalada pero
// el sitio no tiene un solo componente que la use: hidratar React para conmutar
// tres paneles serían decenas de KB de JS en la ruta crítica de un sitio que se
// vendió con posicionamiento. Son 30 líneas de DOM.
//
// 🔴 LOS TRES PANELES ESTÁN SIEMPRE EN EL HTML, ocultos con `hidden` y no
// renderizados condicionalmente. Es contenido nuevo indexable: si el panel no
// existe en el HTML servido, para un buscador —y para un motor generativo— no
// existe. Verificarlo en `dist/`, no en el fuente.
---

<section id="unidades" class="py-20 lg:py-28 bg-neutral-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Nuestra flota</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl text-neutral-800 font-display">
        Unidades
      </h2>
      <p class="mt-4 text-lg text-neutral-800 max-w-2xl mx-auto">
        Conózcanos en imágenes.
      </p>
    </div>

    {/* Barra de pestañas. `flex-wrap` y no `overflow-x-auto`: con dos labels
        largos, en 375 px un scroll horizontal esconde la tercera pestaña sin
        que nada indique que está ahí. Envuelto, se ven las tres siempre. */}
    <div
      role="tablist"
      aria-label="Secciones de unidades"
      class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10"
      data-units-tablist
    >
      {UNIT_TABS.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-units-tab={tab.id}
          class="px-4 py-2.5 sm:px-5 rounded-full text-sm font-bold border transition-colors duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red aria-selected:bg-brand-red aria-selected:text-white aria-selected:border-brand-red bg-white text-neutral-800 border-neutral-200 hover:border-brand-red/40"
        >
          {tab.label}
        </button>
      ))}
    </div>

    {/* ── Panel 1: Flota ─────────────────────────────────────────────────── */}
    <div
      role="tabpanel"
      id="panel-flota"
      aria-labelledby="tab-flota"
      tabindex="0"
      data-units-panel="flota"
      class="mb-16"
    >
      <div id="screen" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {IMAGES.fleet.map((img) => (
          <div class="group relative overflow-hidden rounded-2xl shadow-lg">
            <Image
              src={img.src}
              alt={img.alt}
              class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110"
              widths={[400, 600]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              loading="lazy"
              quality={75}
              style={img.position ? `object-position: ${img.position}` : undefined}
            />
          </div>
        ))}
      </div>
    </div>

    {/* ── Panel 2: Mantenimiento preventivo ──────────────────────────────── */}
    {/* Las dos fotos van con ALTURA IGUAL y ancho libre (`sm:h-[420px] w-auto`),
        no en dos celdas iguales: el taller es apaisado y el lavado es vertical,
        y forzarlas a la misma caja recorta la vertical. Ver `assets.ts`.

        🔴 Y VAN SIN PIE DE FOTO, a propósito. El texto es del panel, no de cada
        imagen: el lavadero no es de la empresa y "limpieza" es una palabra que
        el cliente bajó del sitio, así que cualquier pie sobre esa foto miente o
        desobedece. El porqué completo está en `units-tabs.ts`. */}
    <div
      role="tabpanel"
      id="panel-mantenimiento"
      aria-labelledby="tab-mantenimiento"
      tabindex="0"
      data-units-panel="mantenimiento"
      class="mb-16"
      hidden
    >
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-center gap-6">
        <div class="overflow-hidden rounded-2xl shadow-lg sm:shrink-0">
          <Image
            src={IMAGES.maintenance.taller.src}
            alt={IMAGES.maintenance.taller.alt}
            class="w-full h-auto sm:h-[420px] sm:w-auto"
            widths={[600, 900]}
            sizes="(max-width: 640px) 100vw, 560px"
            loading="lazy"
            quality={75}
          />
        </div>

        <div class="overflow-hidden rounded-2xl shadow-lg sm:shrink-0">
          <Image
            src={IMAGES.maintenance.lavado.src}
            alt={IMAGES.maintenance.lavado.alt}
            class="w-full h-auto sm:h-[420px] sm:w-auto"
            widths={[400, 640]}
            sizes="(max-width: 640px) 100vw, 315px"
            loading="lazy"
            quality={75}
          />
        </div>
      </div>

      <p class="mt-8 mx-auto max-w-3xl text-center text-lg text-neutral-800 leading-relaxed">
        {MAINTENANCE_COPY}
      </p>
    </div>

    {/* ── Panel 3: Sala de control y tráfico ─────────────────────────────── */}
    {/* 🔴 El placeholder es DELIBERADO y bloquea la publicación en el dominio.
        Ver el comentario de `TRAFFIC_PHOTO_PENDING` en units-tabs.ts. */}
    <div
      role="tabpanel"
      id="panel-trafico"
      aria-labelledby="tab-trafico"
      tabindex="0"
      data-units-panel="trafico"
      class="mb-16"
      hidden
    >
      <div class="flex justify-center">
        <div
          class="flex items-center justify-center rounded-2xl border-2 border-dashed border-neutral-300 bg-white/60 h-56 sm:h-[420px] w-full sm:w-[560px]"
        >
          <p class="text-neutral-500 text-sm font-semibold px-6 text-center">
            {TRAFFIC_PHOTO_PENDING}
          </p>
        </div>
      </div>

      <p class="mt-8 mx-auto max-w-3xl text-center text-lg text-neutral-800 leading-relaxed">
        {TRAFFIC_COPY}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {FLEET_SPECS.map((spec) => (
        <div class="flex items-start gap-3 bg-white p-4 rounded-2xl border border-neutral-200/80 shadow-sm">
          <span class="w-3 h-3 rounded-full bg-brand-red mt-1.5 shrink-0"></span>
          <div class="min-w-0">
            <p class="font-bold text-neutral-800 text-sm">{spec.label}</p>
            <p class="text-neutral-800 text-xs mt-0.5 leading-snug font-data">{spec.value}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Conmutador de pestañas de Unidades.
  //
  // Roving tabindex + flechas: es el patrón de tabs de la APG de W3C. Sin esto
  // un usuario de teclado queda obligado a tabular por las tres pestañas antes
  // de llegar al contenido, y los lectores de pantalla no anuncian cuál está
  // activa.
  //
  // Si el JS no corre, queda visible el panel de Flota (los otros dos nacen con
  // `hidden`) y las tres pestañas siguen en el HTML para los buscadores. Se
  // degrada a la sección de antes, no a una rota.
  const tablist = document.querySelector<HTMLElement>('[data-units-tablist]');

  if (tablist) {
    const tabs = Array.from(
      tablist.querySelectorAll<HTMLButtonElement>('[data-units-tab]')
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-units-panel]')
    );

    const activar = (indice: number, mueveFoco = true) => {
      tabs.forEach((tab, i) => {
        const activa = i === indice;
        tab.setAttribute('aria-selected', activa ? 'true' : 'false');
        tab.tabIndex = activa ? 0 : -1;
      });

      const id = tabs[indice]?.dataset.unitsTab;
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.unitsPanel !== id;
      });

      if (mueveFoco) tabs[indice]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activar(i, false));
      tab.addEventListener('keydown', (evento) => {
        const teclas: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        const destino = teclas[evento.key];
        if (destino === undefined) return;
        evento.preventDefault();
        activar(destino);
      });
    });
  }
</script>
