---
import { Image } from 'astro:assets';
import { CLIENTS, SECTORS } from '../config/clients';

const joinWithY = (items: string[]) =>
  items.length > 1
    ? `${items.slice(0, -1).join(', ')} y ${items[items.length - 1]}`
    : items[0];

// Zona 1 (arriba, estática y a mayor tamaño) / Zona 2 (abajo, cinta animada):
// la separación sale del booleano `featured` de cada cliente en config/clients.ts.
// Para mover un cliente de zona: cambiar ese booleano ahí. No hace falta tocar
// este componente.
const FEATURED_CLIENTS = CLIENTS.filter((c) => c.featured);
const MARQUEE_CLIENTS = CLIENTS.filter((c) => !c.featured);

const clientsText = joinWithY(CLIENTS.map((c) => c.name));
const marqueeClientsText = joinWithY(MARQUEE_CLIENTS.map((c) => c.name));
const featuredClientsText = joinWithY(FEATURED_CLIENTS.map((c) => c.name));
// Los sectores van separados por COMAS, no con joinWithY: uno de ellos es
// "papel y tissue", que ya trae su propia "y" adentro. Con el join queda
// "...papel y tissue y madera", que se lee como un error. Con comas, no.
const sectorsText = SECTORS.map((s) => s.toLowerCase()).join(', ');

// Logos de la cinta (marquee), derivados de los clientes NO destacados. Para sumar
// un cliente nuevo a la cinta: agregarlo en config/clients.ts con featured: false
// (o sumar el logo ahí directamente). El alt sale solo del `name`, y la cantidad
// de repeticiones y el desplazamiento de la animación (más abajo) se recalculan
// solos a partir de LOGOS.length.
const LOGOS = MARQUEE_CLIENTS.map((c) => ({
  img: c.image,
  alt: `${c.name}, cliente de Transporte Colussi`,
}));

// La cinta repite el set de logos varias veces seguidas para no dejar huecos en
// pantallas anchas y para que el loop sea continuo (sin salto visible). El
// truco: armar UNA franja larga con REPEAT copias idénticas y animarla
// trasladándola exactamente el ancho de UNA copia (100 / REPEAT %) — al llegar
// ahí, la copia siguiente cae justo donde arrancó la primera. Por eso el
// desplazamiento se calcula a partir de REPEAT en vez de dejarlo fijo: si
// mañana se suman o sacan logos de la cinta, REPEAT se ajusta solo y el loop
// sigue siendo perfecto (el piso de 2 copias es el mínimo matemático para que
// el truco funcione).
const MIN_LOGO_SLOTS = 12;
const REPEAT = Math.max(2, Math.ceil(MIN_LOGO_SLOTS / LOGOS.length));
const marqueeLogos = Array.from({ length: REPEAT * LOGOS.length }, (_, i) => LOGOS[i % LOGOS.length]);
const marqueeOffsetPct = (100 / REPEAT).toFixed(4);
const marqueeDurationS = REPEAT * 6; // 6s "por copia": la velocidad percibida no cambia al sumar logos

// Notas internas (no publicar en el HTML):
//
// LOS NOMBRES DE CLIENTES EN TEXTO PLANO NO SE BORRAN. Están plegados en el
// <details> de abajo, no eliminados, y la diferencia importa: es el entregable
// central de lo que se vendió. Medido en el baseline del 25/07 — el sitio
// aparece SOLO en las consultas cuyas palabras están escritas literales en él.
// Los motores no leen los logos y no infieren lo que falta. Los `alt` tampoco
// alcanzan: la cinta muestra 19 y los destacados 8, pero la lista completa es
// la que tiene que estar legible. Si alguien vuelve a proponer "los logos
// hablan solos", la respuesta es que hablan para las personas, no para las
// máquinas — y este trabajo se vendió para las dos.
//
// Se pliega con CSS (<details> nativo), NUNCA con JavaScript: así el texto
// viaja siempre en el HTML y los crawlers lo leen aunque nadie lo despliegue.
// Mismo patrón que el detalle de Services.astro.
//
// SUBTÍTULO: la primera línea ("Los clientes ocupan la posición más
// importante...") es TEXTUAL del brief del cliente — su filosofía operativa.
// Es texto institucional de ellos: se copia, no se mejora. Un rediseño
// propuso reemplazarla; se conservó por decisión de Franco y se sumó la
// segunda línea debajo, que además absorbe los sectores.
//
// BARRA "24/7 / Flota 100% Propia / NEA" — ELIMINADA el 28/07 por redundante.
// Antes de sacarla se verificó que los tres claims viven en otro lado:
// flota propia en About, Hero y faq.ts; monitoreo satelital en About, Hero,
// fleet.ts, services.ts, faq.ts y CoverageMap; centro de tráfico en About,
// fleet.ts y CoverageMap. No se perdió nada de lo comprometido. De paso muere
// el conflicto de los dos "100%" compitiendo con el de Stats.astro.
---

<section id="clientes" class="bg-neutral-100 border-y border-neutral-200 py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl text-neutral-800 mb-4 font-display">
        Empresas que confían en Transporte Colussi
      </h2>
      <p class="text-lg text-neutral-800 max-w-3xl mx-auto">
        Los clientes ocupan la posición más importante en la empresa, hacemos lo que es mejor para ellos siempre.
      </p>
      <p class="text-base text-neutral-800 max-w-3xl mx-auto mt-3">
        Acompañamos la logística de marcas líderes de {sectorsText}.
      </p>
    </div>

    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10 md:gap-x-12 md:gap-y-14 mb-14"
      role="group"
      aria-label={`Clientes destacados de Transporte Colussi: ${featuredClientsText}`}
    >
      {FEATURED_CLIENTS.map((client) => (
        <div class="flex items-center justify-center h-20 md:h-24">
          <Image
            src={client.image}
            alt={`${client.name}, cliente de Transporte Colussi`}
            class="max-h-16 md:max-h-20 w-auto object-contain"
          />
        </div>
      ))}
    </div>

    <p class="text-center text-sm font-medium text-neutral-500 uppercase tracking-wide mb-8">
      Otras firmas y marcas regionales que operan con nosotros
    </p>

    <div
      class="marquee-viewport relative overflow-hidden mb-10"
      role="group"
      aria-label={`Otras empresas cliente de Transporte Colussi: ${marqueeClientsText}`}
    >
      <div
        class="marquee-track flex items-center gap-10 md:gap-16 w-max"
        style={`--marquee-offset: -${marqueeOffsetPct}%; --marquee-duration: ${marqueeDurationS}s;`}
      >
        {marqueeLogos.map((logo, i) => (
          <div
            class="logo-item flex items-center justify-center h-16 shrink-0"
            aria-hidden={i >= LOGOS.length ? 'true' : undefined}
          >
            <Image src={logo.img} alt={logo.alt} class="h-14 w-auto object-contain" />
          </div>
        ))}
      </div>
    </div>

    <details class="clients-detail max-w-3xl mx-auto text-center">
      <summary class="text-sm font-medium text-neutral-500 hover:text-brand-red transition-colors cursor-pointer select-none">
        Ver la lista completa de clientes
      </summary>
      <div class="pt-5 space-y-3">
        <p class="text-neutral-800">
          Trabajamos para compañías líderes del país y de la región:
          <span class="font-semibold text-neutral-800">{clientsText}</span>.
        </p>
        <p class="text-neutral-800">
          Combinamos clientes de alcance nacional con la industria del norte santafesino: Buyatti, la Unión Agrícola de Avellaneda y Vicentin operan a minutos de nuestra casa central.
        </p>
      </div>
    </details>
  </div>
</section>

<style>
  /* El pliegue es SOLO presentación: el texto está siempre en el HTML, así que
     los crawlers lo leen aunque nadie abra el <details>. Si alguien lo
     "mejora" renderizando el contenido con JS al hacer clic, el texto deja de
     existir para los motores y se rompe justo lo que la sección tiene que
     lograr. Mismo criterio que el detalle plegable de Services.astro. */
  .clients-detail > summary {
    list-style: none;
  }
  .clients-detail > summary::-webkit-details-marker {
    display: none;
  }
  .clients-detail > summary::after {
    content: '+';
    margin-left: 0.4rem;
    display: inline-block;
  }
  .clients-detail[open] > summary::after {
    content: '–';
  }

  .marquee-viewport {
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    animation: marquee var(--marquee-duration, 24s) linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--marquee-offset));
    }
  }

  /* Escala de grises -> color solo con hover real (mouse/trackpad). En touch no
     existe hover: si el filtro no estuviera detrás de este media query, los
     logos quedarían grises para siempre en celular. Con el media query, en
     touch directamente no se aplica ninguna de las dos reglas y se ven a color
     desde el arranque. Solo aplica a la cinta (zona 2): los destacados de la
     zona 1 van siempre a color, son los que tienen que leerse de un vistazo. */
  @media (hover: hover) {
    .logo-item {
      filter: grayscale(1);
      opacity: 0.6;
      transition: filter 0.3s ease, opacity 0.3s ease;
    }
    .logo-item:hover {
      filter: grayscale(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: translateX(0);
    }
  }
</style>
