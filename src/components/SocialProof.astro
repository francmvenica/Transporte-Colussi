---
import { Image } from 'astro:assets';
import cliente1 from '../assets/images/cliente-1.svg';
import cliente2 from '../assets/images/cliente-2.png';
import cliente3 from '../assets/images/cliente-3.svg';
import { CLIENTS, SECTORS } from '../config/clients';

const joinWithY = (items: string[]) =>
  items.length > 1
    ? `${items.slice(0, -1).join(', ')} y ${items[items.length - 1]}`
    : items[0];

const clientsText = joinWithY(CLIENTS.map((c) => c.name));
const sectorsText = joinWithY(SECTORS.map((s) => s.toLowerCase()));

// Logos de la cinta (marquee). Para sumar un logo nuevo cuando Juan Manuel los
// mande: 1) importar el archivo arriba, junto a cliente1/cliente2/cliente3;
// 2) agregar una entrada acá con su alt real (nombre del cliente). No hace falta
// tocar nada más: la cantidad de repeticiones y el desplazamiento de la
// animación (más abajo) se recalculan solos a partir de LOGOS.length.
const LOGOS = [
  { img: cliente1, alt: 'Nestlé, cliente de Transporte Colussi' },
  { img: cliente2, alt: 'Molinos Río de la Plata, cliente de Transporte Colussi' },
  { img: cliente3, alt: 'Arcor, cliente de Transporte Colussi' },
];

// La cinta repite el set de logos varias veces seguidas para no dejar huecos en
// pantallas anchas y para que el loop sea continuo (sin salto visible). El
// truco: armar UNA franja larga con REPEAT copias idénticas y animarla
// trasladándola exactamente el ancho de UNA copia (100 / REPEAT %) — al llegar
// ahí, la copia siguiente cae justo donde arrancó la primera. Por eso el
// desplazamiento se calcula a partir de REPEAT en vez de dejarlo fijo: si
// mañana se suman más logos, REPEAT baja solo y el loop sigue siendo perfecto
// (el piso de 2 copias es el mínimo matemático para que el truco funcione).
const MIN_LOGO_SLOTS = 12;
const REPEAT = Math.max(2, Math.ceil(MIN_LOGO_SLOTS / LOGOS.length));
const marqueeLogos = Array.from({ length: REPEAT * LOGOS.length }, (_, i) => LOGOS[i % LOGOS.length]);
const marqueeOffsetPct = (100 / REPEAT).toFixed(4);
const marqueeDurationS = REPEAT * 6; // 6s "por copia": la velocidad percibida no cambia al sumar logos
---

<section id="clientes" class="bg-neutral-50 border-y border-neutral-200 py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-4">
        Empresas que confían en Transporte Colussi
      </h2>
      <p class="text-lg text-neutral-600 max-w-3xl mx-auto">
        Los clientes ocupan la posición más importante en la empresa, hacemos lo que es mejor para ellos siempre.
      </p>
    </div>

    <!-- Cinta de logos (marquee infinito). Ver LOGOS arriba para sumar clientes nuevos. -->
    <div
      class="marquee-viewport relative overflow-hidden mb-10"
      role="group"
      aria-label={`Empresas cliente de Transporte Colussi: ${clientsText}`}
    >
      <div
        class="marquee-track flex items-center gap-10 md:gap-16 w-max"
        style={`--marquee-offset: -${marqueeOffsetPct}%; --marquee-duration: ${marqueeDurationS}s;`}
      >
        {marqueeLogos.map((logo, i) => (
          <div
            class="logo-item flex items-center justify-center h-16 shrink-0"
            aria-hidden={i >= LOGOS.length ? 'true' : undefined}
          >
            <Image src={logo.img} alt={logo.alt} class="h-14 w-auto object-contain" />
          </div>
        ))}
      </div>
    </div>

    <!-- Clientes en texto plano (además de los logos, para que los motores de búsqueda e IA los lean) -->
    <p class="text-center text-neutral-700 max-w-3xl mx-auto mb-3">
      Trabajamos para compañías líderes de consumo masivo, alimentos e industria:
      <span class="font-semibold text-neutral-900">{clientsText}</span>.
    </p>
    <p class="text-center text-neutral-600 max-w-3xl mx-auto mb-14">
      Trabajamos para las principales industrias del país: {sectorsText}.
    </p>

    <!-- Stats strip -->
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16 pt-8 border-t border-neutral-200">
      <div class="text-center group cursor-default">
        <p class="text-3xl font-bold text-brand-red transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-110">24/7</p>
        <p class="text-xs font-medium text-neutral-600 uppercase tracking-wide transition-colors duration-300 group-hover:text-neutral-900">Monitoreo Satelital</p>
      </div>
      <div class="w-px h-10 bg-neutral-300 hidden md:block"></div>
      <div class="text-center group cursor-default">
        <p class="text-3xl font-bold text-brand-red transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-110">100%</p>
        <p class="text-xs font-medium text-neutral-600 uppercase tracking-wide transition-colors duration-300 group-hover:text-neutral-900">Flota Propia</p>
      </div>
      <div class="w-px h-10 bg-neutral-300 hidden md:block"></div>
      <div class="text-center group cursor-default">
        <p class="text-3xl font-bold text-brand-red transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-110">NEA</p>
        <p class="text-xs font-medium text-neutral-600 uppercase tracking-wide transition-colors duration-300 group-hover:text-neutral-900">Base Operativa</p>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-viewport {
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    animation: marquee var(--marquee-duration, 24s) linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--marquee-offset));
    }
  }

  /* Escala de grises -> color solo con hover real (mouse/trackpad). En touch no
     existe hover: si el filtro no estuviera detrás de este media query, los
     logos quedarían grises para siempre en celular. Con el media query, en
     touch directamente no se aplica ninguna de las dos reglas y se ven a color
     desde el arranque. */
  @media (hover: hover) {
    .logo-item {
      filter: grayscale(1);
      opacity: 0.6;
      transition: filter 0.3s ease, opacity 0.3s ease;
    }
    .logo-item:hover {
      filter: grayscale(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: translateX(0);
    }
  }
</style>
