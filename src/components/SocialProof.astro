---
import { Image } from 'astro:assets';
import { CLIENTS, SECTORS, type Client } from '../config/clients';

const joinWithY = (items: string[]) =>
  items.length > 1
    ? `${items.slice(0, -1).join(', ')} y ${items[items.length - 1]}`
    : items[0];

const clientsText = joinWithY(CLIENTS.map((c) => c.name));
// Los sectores van separados por COMAS, no con joinWithY. Hasta el 08/08 la
// razón concreta era "papel y tissue" (traía su propia "y" adentro y el join
// daba "...papel y tissue y madera", que se lee como un error). "tissue" salió
// de la lista, pero el principio se sostiene: es un config que puede editar
// otro, y el próximo ítem con una "y" o un "&" propios rompería el join de
// nuevo. Con comas no se rompe nunca.
// 🔴 DESDE EL 08/08 esto ya NO va en la línea visible bajo el H2: se renderiza
// dentro del <details> de abajo, a pedido explícito de Romualdo ("para que la
// IA te lo tome").
const sectorsText = SECTORS.map((s) => s.toLowerCase()).join(', ');

const PRINCIPALES = CLIENTS.filter((c) => c.featured);
const RESTO = CLIENTS.filter((c) => !c.featured);

const COLUMNAS = 3;

// Reparto por módulo para conservar el orden de config/clients.ts: la columna
// `col` se queda con los índices col, col+3, col+6… Con 12 principales caen 4
// por columna, y esas 4 filas son exactamente el cuadro congelado inicial.
const repartir = (items: Client[], col: number) => items.filter((_, i) => i % COLUMNAS === col);

// Arma el ciclo de una columna: el bloque de principales adelante (es el cuadro
// congelado) y después el resto, con los principales repetidos en el medio.
//
// 🔴 LA CUENTA SE HACE SOBRE EL CICLO COMPLETO Y EN CÍRCULO, no sobre el tramo
// de atrás. Esa era la versión anterior y tenía un bug real, reportado por
// Franco el 31/07 mirando el sitio publicado ("Walmart aparece muy seguido, es
// como que se restablece"): repartía las repeticiones dentro del tramo
// posterior sin saber que el ciclo arranca con el bloque de principales ni que
// la cinta vuelve a empezar. En la columna de Walmart el ciclo TERMINABA en él
// y el bloque lo traía de vuelta 4 lugares después — contra 6, 7 y 8 de los
// demás. Ese amontonamiento en la costura es lo que se lee como un reinicio.
//
// La regla ahora son dos líneas. La repetición del principal que está en la
// posición k va cerca de k + mitad del ciclo: así las dos apariciones quedan en
// puntos opuestos y la separación es pareja para todos, medida dando la vuelta.
// Es el "que se separe la repetición" de Romualdo, que con la versión anterior
// no se cumplía justo para el último de cada columna.
//
// Y la segunda línea: el bloque de repeticiones va CON LOS PARES INTERCAMBIADOS,
// no en el mismo orden que el bloque de arriba. Sin eso, la misma secuencia de
// logos se repite idéntica a media vuelta y se lee como que la cinta volvió a
// empezar — el otro síntoma que marcó Franco ("pasan dos veces las mismas
// marcas"). Cambiar el orden cuesta un lugar de separación (mínimo 5 en vez
// de 6) y a cambio ninguna secuencia se repite igual. Se eligió eso: con la
// ventana de 4 filas que se ve, 5 alcanza para que un logo salga de pantalla
// antes de volver, y el patrón repetido sí se nota.
const armarCiclo = (principales: Client[], resto: Client[]): Client[] => {
  if (!principales.length) return resto;
  const largo = principales.length * 2 + resto.length;
  const mitad = Math.floor(largo / 2);

  // [0,1,2,3] -> [1,0,3,2]: intercambia de a pares. Con impares, el último queda.
  const intercambiado = principales.map((_, k) =>
    k % 2 === 0 ? Math.min(k + 1, principales.length - 1) : k - 1,
  );

  const ciclo: (Client | undefined)[] = new Array(largo);
  principales.forEach((cliente, k) => {
    ciclo[k] = cliente; // el bloque del cuadro congelado
  });
  intercambiado.forEach((origen, k) => {
    ciclo[(mitad + k) % largo] = principales[origen]; // la repetición, a media vuelta
  });

  // El resto rellena los huecos que quedan, en orden.
  let ri = 0;
  for (let i = 0; i < largo; i++) if (!ciclo[i] && ri < resto.length) ciclo[i] = resto[ri++];

  return ciclo.filter((c): c is Client => Boolean(c));
};

// Un `alt` por cliente y nada más: el mismo logo aparece varias veces (las dos
// copias del loop + las repeticiones de los principales) y un lector de
// pantalla no tiene por qué escuchar "Nestlé, cliente de Transporte Colussi"
// seis veces. La primera aparición lo anuncia; las demás van aria-hidden.
const yaAnunciado = new Set<string>();

const columnas = Array.from({ length: COLUMNAS }, (_, col) => {
  const principales = repartir(PRINCIPALES, col);
  const ciclo = armarCiclo(principales, repartir(RESTO, col));
  // DOS copias idénticas y el loop cierra desplazando exactamente una (-50%):
  // al llegar al final de la primera, la segunda está justo donde arrancó.
  const items = [...ciclo, ...ciclo].map((cliente) => {
    const primera = !yaAnunciado.has(cliente.name);
    yaAnunciado.add(cliente.name);
    return { ...cliente, primera };
  });
  return {
    items,
    // La duración sale del largo del ciclo para que las tres columnas corran a
    // la MISMA velocidad aunque tengan distinta cantidad de logos. Con una
    // duración fija, la columna más corta se vería más rápida.
    duracion: `${(ciclo.length * 1.9).toFixed(1)}s`,
    reverse: col === 1,
  };
});

// Notas internas (no publicar en el HTML):
//
// 🔴 UNA SOLA CINTA, NO DOS ZONAS (reescrito el 2026-07-30). Hasta ahora la
// sección tenía destacados estáticos arriba + cinta horizontal abajo, y ESO era
// lo que el cliente pidió sacar el 29/07. Juan Manuel: "que no quede claro que
// estamos discriminando (…) que estén todos en la misma línea, pero que Arcor,
// Nestlé y Molino se vean más". Romualdo, mirando la sección publicada: "esto
// queda lindo, pero me dice que estos son los principales". La solución no era
// reordenar las dos zonas: es que haya una sola y que la jerarquía la den la
// posición inicial y la repetición, no una separación visible.
//
// LA MECÁNICA, tal como la pidieron:
//   · Arranca CONGELADA en los 12 principales — "el primer pantallazo tiene que
//     ser los principales (…) la primera imagen te deja fijado los 11, 12".
//   · El movimiento empieza CUANDO EL USUARIO LLEGA, no antes ("después empieza
//     a correr"), y con una PAUSA de 3 s (subida de 1,2 s el 08/08, pedido del
//     cliente) para que el ojo alcance a registrar el cuadro congelado. Sin esa
//     pausa, "el primer pantallazo" no existe nunca: la cinta ya está corriendo
//     cuando el visitante llega.
//   · Corre en VERTICAL con foco central: la columna del medio en sentido
//     inverso, los logos del centro a color y los extremos apagándose. Es el
//     efecto que propuso Romualdo y aprobó Juan Manuel ("Me gusta. Probemos.").
//   · Los principales se REPITEN, separados, para que "cuando el lector baja
//     esté en las empresas que a nosotros nos interesan" (Juan Manuel).
//
// 🔑 EL FOCO CENTRAL SOLO SE APLICA MIENTRAS SE MUEVE, y no es un detalle: si
// el gris de los extremos estuviera activo en reposo, el cuadro congelado
// mostraría 6 principales a color y 6 apagados — o sea, volvería a decir "estos
// son los importantes" justo en la sección donde nos pidieron que eso no se
// notara. En reposo van los 12 a color; el foco entra con el movimiento.
//
// EL FOCO VA CON JS Y NO SE PUEDE HACER SOLO CON CSS: el degradado de máscara
// apaga los extremos por opacidad, pero "el centro a color" necesita saber qué
// logo está en la banda central en cada momento, y eso no es expresable en CSS.
// Lo resuelve un IntersectionObserver cuyo root es el viewport de la cinta,
// recortado por rootMargin a la banda del medio. La clase `is-js` la agrega el
// script: SIN JavaScript los logos quedan todos a color (nunca todos en gris) y
// el degradado sigue funcionando igual.
//
// El filtro va en el DIV que envuelve al logo, no en el <img>: los estilos de
// Astro son scopeados y no alcanzan al markup que renderiza <Image>, así que
// apuntarle al img exigiría `:global()`. Sobre el div cae igual y sin trampas.
//
// LA LISTA EN TEXTO NO SE TOCA. Sigue plegada en el <details> de abajo, que
// Juan Manuel validó explícitamente ("eso está perfecto"), y sigue viajando
// entera en el HTML: es el entregable central de lo que se vendió, y los
// motores no leen logos. Su reparo quedó anotado: "el tema es que hay que ver
// si lo lee bien". Se pliega con CSS, NUNCA con JS.
//
// NO se replicó la lista de tags visible que traía la maqueta debajo de la
// cinta: duplicaba la lista del <details> a la vista, que es exactamente lo que
// se había plegado para no hacer ruido visual (decisión del 28/07).
//
// 🔴 JERARQUÍA INVERTIDA EL 08/08. Hasta ahora "Agradecemos a las empresas..."
// era el H2 y "Los clientes ocupan la posición más importante..." un párrafo
// debajo. Se dieron vuelta: la frase de filosofía operativa pasa a H2 y el
// agradecimiento baja a H3, pegado arriba de la cinta. Ninguna de las dos
// frases se reescribió — es un cambio de jerarquía visual, no de copy — así
// que sigue valiendo todo lo que dice el resto de esta nota sobre CADA frase:
//
// "Los clientes ocupan la posición más importante..." es TEXTUAL del brief del
// cliente — su filosofía operativa. Texto institucional de ellos: se copia, no
// se mejora.
//
// "Agradecemos a las empresas que confiaron en nosotros" lo dictó Romualdo por
// audio de WhatsApp el 30/07 a las 10:01: "Agradecemos a las siguientes
// empresas que confiaron en nosotros". No era solo pasar "confían" a
// "confiaron" —eso salió de la reunión del 29/07, porque "si ponemos 'confían'
// quiere decir que están actualmente" y varios ya no operan con ellos— es el
// título entero. Franco sacó "siguientes" el mismo 30/07 al verlo publicado:
// "las siguientes" anuncia una lista y abajo hay una cinta en movimiento, no
// una lista.
//
// ⚠️ EL H3 TIENE QUE VERSE CLARAMENTE SUBORDINADO AL H2 (pedido del director,
// 08/08), o la jerarquía se invierte a la vista aunque el HTML esté bien: va
// más chico, más liviano y en un gris más apagado que el H2 (que sigue en
// font-display y neutral-800).
//
// El `max-w-*` de cada título no es decorativo: controla en cuántas líneas
// parte. El H2 viejo (54 caracteres) usaba max-w-3xl para partir en dos líneas
// parejas; el nuevo (98 caracteres, la frase de filosofía) es casi el doble de
// largo, así que se recalibró mirando 1280 y 375 — con `text-balance` puesto,
// que reparte el texto entre las líneas que el navegador elija sin dejar una
// palabra sola. Si se vuelve a tocar el texto de cualquiera de los dos
// títulos, volver a mirar el recorte de línea: no se hereda del anterior.
---

<section id="clientes" class="bg-neutral-100 border-y border-neutral-200 py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl text-neutral-800 mb-3 font-display max-w-2xl mx-auto text-balance">
        Los clientes ocupan la posición más importante en la empresa, hacemos lo que es mejor para ellos siempre
      </h2>
      <h3 class="text-base sm:text-lg font-semibold text-neutral-500 max-w-2xl mx-auto">
        Agradecemos a las empresas que confiaron en nosotros
      </h3>
    </div>

    <div
      id="clientes-cinta"
      class="vmarquee relative mx-auto max-w-3xl"
      role="group"
      aria-label={`Clientes de Transporte Colussi: ${clientsText}`}
    >
      <div class="grid grid-cols-3 gap-3 sm:gap-6 h-full">
        {columnas.map((columna) => (
          <div
            class:list={['vcol flex flex-col gap-3 sm:gap-6', { rev: columna.reverse }]}
            style={`--vdur: ${columna.duracion}`}
          >
            {columna.items.map((cliente) => (
              <div class="vlogo flex items-center justify-center h-20 sm:h-24 shrink-0">
                {cliente.image ? (
                  <Image
                    src={cliente.image}
                    alt={cliente.primera ? `${cliente.name}, cliente de Transporte Colussi` : ''}
                    aria-hidden={cliente.primera ? undefined : 'true'}
                    class="max-h-12 sm:max-h-16 max-w-[85%] w-auto object-contain"
                    style={cliente.visualScale ? `transform: scale(${cliente.visualScale})` : undefined}
                  />
                ) : (
                  <p
                    class="font-bold text-neutral-600 text-2xl sm:text-4xl text-center leading-tight px-1"
                    aria-hidden={cliente.primera ? undefined : 'true'}
                  >
                    {cliente.name}
                  </p>
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <details class="clients-detail max-w-3xl mx-auto text-center mt-10">
      <summary class="text-sm font-medium text-neutral-500 hover:text-brand-red transition-colors cursor-pointer select-none">
        Ver más clientes
      </summary>
      <div class="pt-5 space-y-3">
        <p class="text-neutral-800">
          Trabajamos para compañías del país y de la región:
          <span class="font-semibold text-neutral-800">{clientsText}</span>.
        </p>
        <p class="text-neutral-800">
          Acompañamos la logística de {sectorsText}.
        </p>
      </div>
    </details>
  </div>
</section>

<style>
  /* La altura son exactamente 4 filas + sus 3 gaps, y de ahí sale que el cuadro
     congelado muestre 12 logos (4 filas × 3 columnas) = los 12 principales.
     Si se cambia el alto de la fila (h-20/h-24) o el gap, hay que cambiar esto
     o el cuadro deja de coincidir con la cantidad de principales. */
  .vmarquee {
    /* El gap vive acá como variable porque lo necesitan dos cosas a la vez: la
       clase de Tailwind que separa los logos (gap-3 / sm:gap-6) y el
       padding-bottom de .vcol que cierra el loop. Si se cambia uno hay que
       cambiar el otro, o el salto de la vuelta vuelve. */
    --vgap: 0.75rem;
    height: calc(5rem * 4 + 0.75rem * 3);
    overflow: hidden;
    /* El degradado apaga los extremos: no es decoración, es la mitad del efecto
       que pidió Romualdo (la otra mitad es el color del centro, que va por JS).
       Es suave a propósito —15%/85%— para que en reposo las 4 filas del cuadro
       congelado se lean: con el 25% de la maqueta, la primera y la última fila
       quedaban casi invisibles y el "primer pantallazo" mostraba 6 logos, no 12. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  }

  @media (min-width: 640px) {
    .vmarquee {
      --vgap: 1.5rem; /* acompaña a sm:gap-6 — ver la nota de --vgap arriba */
      height: calc(6rem * 4 + 1.5rem * 3);
    }
  }

  .vcol {
    /* 🔴 EL PADDING NO ES ESPACIADO: ES LO QUE HACE QUE EL LOOP CIERRE.
       La animación desplaza -50% de la altura de la columna, y con 2 copias de
       C logos eso sería exacto… si hubiera 2C gaps. Pero `gap` pone separación
       ENTRE elementos: con 2C logos hay 2C-1 gaps, uno menos. Así que -50%
       queda MEDIO GAP corto y la cinta pega un salto de 12 px en cada vuelta.
       Medido el 31/07: desplazaba 1548 px donde tenía que desplazar 1560.
       Ese salto es lo que Franco veía como "es como que se restablece" —
       reportado dos veces, y la primera se atribuyó entero al orden de los
       logos, que era otro bug distinto (ese sí, el de Walmart).
       Este padding agrega el gap que falta al final: la altura pasa a ser
       2C·(logo+gap) y -50% cae justo en el inicio de la segunda copia. */
    padding-bottom: var(--vgap);
    /* 🔴 Y ESTA LÍNEA ARREGLA EL SALTO GRANDE, que era peor que el del gap.
       Las tres columnas viven en un grid, que por defecto las estira todas a la
       altura de la más alta. Las de 13 logos miden 3120 px; la de 12 mide 2880
       de contenido pero el grid la estiraba a 3120 igual — y como translateY(-50%)
       se calcula sobre la altura del elemento, esa columna desplazaba 1560 px
       donde tenía que desplazar 1440: **120 px de salto en cada vuelta.**
       Con `align-self: start` cada columna conserva su altura real.
       ⚠️ Y esa era justo la columna de Walmart, que es donde Franco lo notó. */
    align-self: start;
    animation: vscroll var(--vdur, 24s) linear infinite;
    /* PAUSADA POR DEFECTO. El script la larga cuando la sección entra en
       pantalla y después de la pausa del cuadro congelado. Sin esto el
       movimiento arranca con la carga de la página y el visitante llega cuando
       los principales ya pasaron. */
    animation-play-state: paused;
  }

  .vcol.rev {
    animation-name: vscroll-rev;
  }

  .is-running .vcol {
    animation-play-state: running;
  }

  @keyframes vscroll {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  /* La columna del medio corre al revés. Arranca en -50% —o sea, en el inicio
     de la segunda copia— así que en reposo muestra los mismos logos que las
     otras dos: el cuadro congelado queda parejo en las tres. */
  @keyframes vscroll-rev {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }

  /* Foco central. Va sobre el div (no sobre el img) y SOLO con `is-running`:
     en reposo los 12 principales van todos a color. Ver la nota del
     frontmatter — si el gris estuviera activo en reposo, el cuadro congelado
     volvería a marcar quiénes son los importantes. */
  .vmarquee.is-js .vlogo {
    transition: filter 0.7s ease, opacity 0.7s ease;
  }

  .vmarquee.is-js.is-running .vlogo {
    filter: grayscale(1);
    opacity: 0.4;
  }

  .vmarquee.is-js.is-running .vlogo.is-focus {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Sin movimiento queda el cuadro congelado con los principales a color, que
       es justamente el "primer pantallazo" que pidió el cliente: degrada a la
       vista que ellos querían, no a algo roto. */
    .vcol {
      animation: none;
    }
    .vmarquee.is-js.is-running .vlogo {
      filter: none;
      opacity: 1;
    }
  }
</style>

<script>
  const cinta = document.getElementById('clientes-cinta');
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cinta && !sinMovimiento) {
    cinta.classList.add('is-js');

    // Foco central: el root es la cinta, recortada por rootMargin a la banda del
    // medio (40% de la altura). El logo que intersecta esa banda va a color. Se
    // recrea en resize porque rootMargin va en píxeles y la altura de la cinta
    // cambia con el breakpoint.
    const logos = cinta.querySelectorAll('.vlogo');
    let foco: IntersectionObserver | null = null;

    const observarFoco = () => {
      if (foco) foco.disconnect();
      const alto = cinta.clientHeight;
      const recorte = Math.round((alto - alto * 0.4) / 2);
      foco = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            entrada.target.classList.toggle('is-focus', entrada.isIntersecting);
          }
        },
        { root: cinta, rootMargin: `-${recorte}px 0px -${recorte}px 0px` },
      );
      for (const logo of logos) foco.observe(logo);
    };

    observarFoco();

    let reajuste: number;
    window.addEventListener('resize', () => {
      clearTimeout(reajuste);
      reajuste = window.setTimeout(observarFoco, 200);
    });

    // Arranque: el movimiento empieza cuando la sección entra en pantalla, con
    // 3 s de pausa para que se vea el cuadro congelado (subida de 1,2 s el
    // 08/08, pedido del cliente). Se pausa al salir —no hay razón para animar
    // lo que nadie mira— pero la pausa del arranque no se repite: se muestra
    // una vez, en la primera llegada.
    let espera: number;
    let yaArranco = false;

    const arranque = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (entrada.isIntersecting) {
            clearTimeout(espera);
            espera = window.setTimeout(
              () => {
                cinta.classList.add('is-running');
                yaArranco = true;
              },
              yaArranco ? 0 : 3000,
            );
          } else {
            clearTimeout(espera);
            cinta.classList.remove('is-running');
          }
        }
      },
      { threshold: 0.25 },
    );
    arranque.observe(cinta);
  }
</script>
