---
import { SITE } from '../config/site';
---

<section id="contactos" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Contacto</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900">
        Hablemos de tu carga
      </h2>
      <!-- Tiempo de respuesta: frase heredada del build de mayo, pendiente de confirmación de Romualdo -->
      <p class="mt-4 text-lg text-neutral-600 max-w-2xl mx-auto">
        Escribinos por WhatsApp y te respondemos en menos de 24 horas hábiles.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <!-- WhatsApp CTA (3 cols) -->
      <div class="lg:col-span-3 bg-gradient-to-br from-white to-neutral-100 rounded-2xl p-10 lg:p-12 border border-neutral-200 flex flex-col items-center justify-center text-center">
        <div class="w-20 h-20 bg-green-500/10 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-10 h-10 text-green-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-neutral-900 mb-3">Escribinos por WhatsApp</h3>
        <p class="text-neutral-600 mb-8 max-w-sm">
          Contanos qué necesitás transportar y te respondemos directamente por WhatsApp.
        </p>
        <a
          href={SITE.whatsapp.link}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button inline-flex items-center justify-center px-8 py-4 bg-brand-red text-white font-semibold text-lg rounded-xl shadow-lg shadow-brand-red/20 transition-all duration-200 hover:bg-brand-red-dark hover:shadow-xl hover:shadow-brand-red/30 hover:-translate-y-0.5"
        >
          Iniciar conversación
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Info + Map (2 cols) -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Map -->
        <div class="rounded-2xl overflow-hidden shadow-lg border border-neutral-200 h-64">
          <iframe
            src={SITE.maps.embedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de Transporte Colussi en Google Maps"
          ></iframe>
        </div>

        <!-- Contact details -->
        <div class="space-y-6">
          {SITE.sedes.map((sede) => (
            <div class="bg-neutral-50 rounded-xl p-5 border border-neutral-200">
              <h3 class="font-bold text-neutral-900 mb-3">{sede.name}</h3>
              <div class="space-y-3 text-sm">
                <div class="flex items-start gap-3">
                  <span class="flex items-center justify-center w-7 h-7 rounded-full bg-brand-red-light flex-shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  </span>
                  <p class="text-neutral-600 pt-1">{sede.address}</p>
                </div>
                <div class="flex items-center gap-3">
                  <span class="flex items-center justify-center w-7 h-7 rounded-full bg-brand-red-light flex-shrink-0">
                    <svg class="w-3.5 h-3.5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                  </span>
                  <a href={`mailto:${sede.email}`} class="text-brand-red hover:underline">{sede.email}</a>
                </div>
                <div class="flex items-center gap-3">
                  <span class="flex items-center justify-center w-7 h-7 rounded-full bg-brand-red-light flex-shrink-0">
                    <svg class="w-3.5 h-3.5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                  </span>
                  <a href={`tel:${sede.phoneRaw}`} class="text-neutral-600 hover:text-brand-red">{sede.phone}</a>
                </div>
                {sede.phoneSecondary && (
                  <div class="flex items-center gap-3">
                    <span class="flex items-center justify-center w-7 h-7 rounded-full bg-brand-red-light flex-shrink-0">
                      <svg class="w-3.5 h-3.5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                      </svg>
                    </span>
                    <a href={`tel:${sede.phoneSecondaryRaw}`} class="text-neutral-500 hover:text-brand-red text-xs">{sede.phoneSecondary}</a>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }
    .cta-button:hover {
      transform: none;
    }
  }
</style>
