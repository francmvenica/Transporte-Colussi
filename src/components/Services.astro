---
import { SERVICES } from '../config/services';
---

<section id="soluciones" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Qué hacemos</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 font-display">
        Nuestros Servicios
      </h2>
      <p class="mt-4 text-lg text-neutral-600 max-w-2xl mx-auto">
        Soluciones integrales de transporte y logística adaptadas a las necesidades de cada cliente.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SERVICES.map((service) => (
        <article
          class="service-card group relative flex flex-col bg-white border border-neutral-200 rounded-2xl overflow-hidden p-8 hover:shadow-xl hover:border-brand-red/20 transition-all duration-300 hover:-translate-y-1"
        >
          <div class="absolute top-0 left-0 right-0 h-0 bg-brand-red group-hover:h-1.5 transition-all duration-300"></div>
          <div class="w-14 h-14 bg-brand-red-light rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red transition-colors duration-300">
            {service.icon === 'Truck' && (
              <svg class="w-7 h-7 text-brand-red group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
              </svg>
            )}
            {service.icon === 'Container' && (
              <svg class="w-7 h-7 text-brand-red group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
              </svg>
            )}
            {service.icon === 'Package' && (
              <svg class="w-7 h-7 text-brand-red group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
            )}
            {service.icon === 'Globe' && (
              <svg class="w-7 h-7 text-brand-red group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-bold text-neutral-900 mb-3 text-balance">{service.title}</h3>
          <p class="text-neutral-600 leading-relaxed">{service.summary}</p>
          <details class="service-details mt-auto pt-5">
            <summary
              class="inline-flex items-center gap-1.5 cursor-pointer text-sm font-semibold text-brand-red hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red rounded-sm"
            >
              <span class="summary-label summary-label-closed">Ver detalle</span>
              <span class="summary-label summary-label-open">Ocultar detalle</span>
              <svg class="summary-chevron w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="mt-3 text-neutral-600 leading-relaxed">{service.description}</p>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* El detalle se pliega solo con CSS: el texto viaja siempre en el HTML para
     que los crawlers lo lean. No reemplazar por render condicional en JS. */
  .service-details > summary {
    list-style: none;
  }
  .service-details > summary::-webkit-details-marker {
    display: none;
  }
  .summary-chevron {
    transition: transform 0.2s ease;
  }
  .service-details[open] .summary-chevron {
    transform: rotate(180deg);
  }
  .summary-label-open {
    display: none;
  }
  .service-details[open] .summary-label-closed {
    display: none;
  }
  .service-details[open] .summary-label-open {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card *,
    .summary-chevron {
      transition: none;
    }
    .service-card:hover {
      transform: none;
    }
  }
</style>
