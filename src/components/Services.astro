---
import { SERVICES } from '../config/services';

// Notas internas (no publicar en el HTML):
//
// FORMATO DE LAS TARJETAS (unificado el 28/07). Antes eran tarjetas grandes con
// un ícono de 56px arriba; ahora usan el MISMO lenguaje que las tarjetas del
// mapa de cobertura y de "Unidades": fondo blanco, borde suave, punto rojo a la
// izquierda y jerarquía título/descripción. El sitio tenía cuatro tratamientos
// distintos para la misma idea y se leía desordenado. Si se toca una de las
// tres, tocar las otras dos — el valor está en que sean iguales.
//
// Los íconos SVG se eliminaron de acá, pero el campo `icon` SIGUE en
// config/services.ts a propósito: no molesta y evita perder el mapeo si algún
// día se vuelven a usar.
//
// DOS COSAS QUE NO SE TOCAN AL COMPACTAR:
// 1. El <details> con el detalle técnico. Ahí viven "pallets", "curtain
//    sider" y "cross-docking" — el vocabulario por el que los motores
//    encuentran a la empresa. Se pliega con CSS, nunca con JS, así el texto
//    viaja siempre en el HTML.
// 2. Los títulos COMPLETOS ("Transporte de Cargas Generales", no "Cargas
//    Generales"). Fue un pedido explícito del cliente el 27/07, y además son
//    las frases que la gente escribe al buscar.
---

<section id="soluciones" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Qué hacemos</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 font-display">
        Nuestros Servicios
      </h2>
      <p class="mt-4 text-lg text-neutral-600 max-w-2xl mx-auto">
        Soluciones integrales de transporte y logística adaptadas a las necesidades de cada cliente.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SERVICES.map((service) => (
        <article
          class="service-card group flex flex-col bg-white border border-neutral-200/80 rounded-2xl shadow-sm p-5 hover:shadow-lg hover:border-brand-red/20 transition-all duration-300"
        >
          <div class="flex items-start gap-3">
            <span class="w-3 h-3 rounded-full bg-brand-red mt-1.5 shrink-0"></span>
            <div class="min-w-0">
              <h3 class="text-base font-bold text-neutral-900 text-balance">{service.title}</h3>
              <p class="text-neutral-600 text-sm mt-1 leading-relaxed">{service.summary}</p>
            </div>
          </div>
          <details class="service-details mt-auto pt-4">
            <summary
              class="inline-flex items-center gap-1.5 cursor-pointer text-sm font-semibold text-brand-red hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-red rounded-sm"
            >
              <span class="summary-label summary-label-closed">Ver detalle</span>
              <span class="summary-label summary-label-open">Ocultar detalle</span>
              <svg class="summary-chevron w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">{service.description}</p>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* El detalle se pliega solo con CSS: el texto viaja siempre en el HTML para
     que los crawlers lo lean. No reemplazar por render condicional en JS. */
  .service-details > summary {
    list-style: none;
  }
  .service-details > summary::-webkit-details-marker {
    display: none;
  }
  .summary-chevron {
    transition: transform 0.2s ease;
  }
  .service-details[open] .summary-chevron {
    transform: rotate(180deg);
  }
  .summary-label-open {
    display: none;
  }
  .service-details[open] .summary-label-closed {
    display: none;
  }
  .service-details[open] .summary-label-open {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card *,
    .summary-chevron {
      transition: none;
    }
    .service-card:hover {
      transform: none;
    }
  }
</style>
