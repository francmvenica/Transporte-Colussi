---
import { Image } from 'astro:assets';
import { SITE } from '../config/site';
import { HERO_VIDEOS, HERO_VIDEO_SLIDE_MS } from '../config/hero';

// Notas internas (no publicar en el HTML):
//
// HERO CON VIDEO. Reemplazó al carrusel de 7 fotos el 29/07. La estructura
// (slides, controles, gradientes dobles, puntos de navegación) vino de un
// handoff de Antigravity; acá quedó ya saneada para producción.
//
// LO QUE SE SACÓ DEL HANDOFF, y por qué — no volver a meterlo:
//   · El badge "Maqueta Hero Video · 3 de 4 Videos cargados": texto interno.
//   · El bloque "Video actual: [título]": era un selector de debug.
//   · El cartel "4to Video (Pendiente) — El espacio se activará automáticamente
//     apenas agregues el 4to video": instrucción para Franco, visible al
//     cliente. Ahora ese slide muestra su poster y nada más.
//   · El botón de sonido: los videos se recomprimieron SIN pista de audio, así
//     que no tenía nada que activar. Además Romualdo pidió el institucional
//     "probablemente sin música".
//   · Siete comentarios de markup: viajan al navegador. Van acá con `//`.
//
// PESO — los videos van en public/ porque Astro NO optimiza video (su pipeline
// es solo de imágenes), así que la compresión se hace a mano ANTES de
// copiarlos. Los originales pesaban 33,58 MB en total y quedaron en 4,64 MB
// (-86%) con este comando, que es el que hay que repetir por cada video nuevo:
//
//   ffmpeg -i entrada.mp4 -vf "scale=1280:-2" -c:v libx264 -crf 28 \
//          -preset slow -an -movflags +faststart salida.mp4
//
// 720p y CRF 28 se eligieron comparando frames contra el original: a este
// tamaño, y con dos gradientes encima, no se distingue. `-an` saca el audio
// (nadie lo escucha en un hero) y `+faststart` deja el índice al principio
// para que arranque sin descargar todo. Los ORIGINALES sin comprimir viven en
// Temp/Colussi-material/videos-hero-originales/ — recomprimir sobre un
// comprimido degrada, siempre partir de ahí.
//
// CARGA: solo el primer video precarga. Los demás van preload="none" y no
// bajan un byte hasta que el carrusel llega a ellos.
//
// EL BOTÓN DE PAUSA NO SE ELIMINA, aunque moleste visualmente. Es lo único
// que cumple WCAG 2.2.2 (control para contenido en movimiento automático de
// más de 5 segundos), que es criterio AA igual que el resto del sitio, y el
// carrusel rota solo cada 8 s. `prefers-reduced-motion` ya está contemplado
// —arranca detenido— pero eso cubre a quien declaró la preferencia en su
// sistema operativo, no a todos.
//
// Lo que SÍ se hizo (29/07, a pedido de Franco: "no tiene ningún sentido") fue
// bajarlo de un botón de 125×33 con el texto "Pausar Video" a un ícono
// circular de 36×36 sin texto, más apagado. La accesibilidad la sostiene ahora
// el `aria-label`, que el script actualiza al alternar. **Ojo si alguien
// vuelve a intentar borrarlo:** el script hace `if (!playPause) return`, así
// que sacar el botón sin tocar el JS **apaga la rotación automática entera**.
//
// GRADIENTE IZQUIERDO subido a 96/88/45 (venía 92/75/40). Motivo concreto: en
// el video "coastal" la lona del semi lleva pintado un teléfono que NO es el
// de la empresa, y en el render con el texto encima se alcanzaba a leer justo
// detrás del H1. Se resolvió oscureciendo la mitad izquierda, que es donde
// vive el texto — y de paso mejora su contraste.
//
// Se evaluó `object-position` para desplazar el encuadre y se descartó: con
// `object-cover`, cuánto se recorta a los lados depende del aspect ratio de
// CADA pantalla, así que un desplazamiento calibrado en un tamaño deja de
// servir en otro. El gradiente no depende del viewport.

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const getVideoUrl = (src: string) => {
  if (!src) return '';
  const cleanSrc = src.startsWith('/') ? src.slice(1) : src;
  return `${base}${cleanSrc}`;
};
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-neutral-950"
>
  <div
    id="hero-slides"
    class="absolute inset-0"
    data-slide-ms={HERO_VIDEO_SLIDE_MS}
    style={`--hero-slide-ms: ${HERO_VIDEO_SLIDE_MS}ms`}
  >
    {HERO_VIDEOS.map((video, i) => (
      <div
        class:list={['hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out', i === 0 ? 'is-active opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none']}
        data-index={i}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        {video.src ? (
          <video
            class="hero-video-element w-full h-full object-cover scale-105 transition-transform duration-10000 ease-linear"
            src={getVideoUrl(video.src)}
            poster={video.poster.src}
            autoplay={i === 0}
            loop
            muted
            playsinline
            preload={i === 0 ? 'auto' : 'none'}
          />
        ) : (
          <Image
            src={video.poster}
            alt={video.alt}
            class="w-full h-full object-cover"
            quality={52}
          />
        )}
      </div>
    ))}
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/96 via-neutral-950/88 to-neutral-950/45 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-neutral-950/50 pointer-events-none"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
    <div class="max-w-3xl">
      <p class="text-brand-red font-semibold text-sm sm:text-base uppercase tracking-widest mb-4 animate-fade-up">
        {SITE.tagline}
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white leading-tight mb-6 animate-fade-up font-display" style="animation-delay: 0.1s">
        Conectamos el NEA<br />
        <span class="text-brand-red font-brand-italic">con todo el país</span>
      </h1>
      <p class="text-lg sm:text-xl text-neutral-300 max-w-xl animate-fade-up" style="animation-delay: 0.2s">
        Flota propia con monitoreo satelital 24/7. Carga general, contenedores, logística y distribución.
      </p>
    </div>
  </div>
  <div
    class="absolute bottom-8 left-4 right-4 sm:left-8 sm:right-28 z-20 flex flex-wrap items-center justify-between gap-3 pointer-events-none"
    role="group"
    aria-label="Controles del carrusel de videos"
  >
    <div class="flex items-center gap-2 pointer-events-auto">
      <button
        id="hero-playpause"
        type="button"
        class="inline-flex items-center justify-center w-9 h-9 bg-neutral-950/50 backdrop-blur-md rounded-full border border-white/10 text-neutral-400 hover:text-white hover:bg-neutral-950/70 hover:border-white/30 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-pressed="false"
        aria-label="Pausar el carrusel de videos"
      >
        <svg class="hero-icon-pause w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 4h4v16H6zM14 4h4v16h-4z" />
        </svg>
        <svg class="hero-icon-play w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 4l13 8-13 8z" />
        </svg>
      </button>

    </div>
    <div class="pointer-events-auto flex items-center gap-2">
      {HERO_VIDEOS.map((video, i) => (
        <button
          type="button"
          class:list={['hero-dot relative w-5 sm:w-7 h-1.5 rounded-full overflow-hidden bg-white/25 transition-colors hover:bg-white/45 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white', i === 0 && 'is-active']}
          data-index={i}
          aria-label={`Ver video ${i + 1} de ${HERO_VIDEOS.length}: ${video.title}`}
          aria-current={i === 0 ? 'true' : 'false'}
        >
          <span class="hero-dot-fill absolute inset-y-0 left-0 w-0 bg-brand-red"></span>
        </button>
      ))}
    </div>
  </div>

  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-10 animate-bounce pointer-events-none hidden sm:block">
    <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  .hero-slide.is-active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .hero-dot-fill {
    width: 0;
  }
  .hero-dot-fill.is-running {
    width: 100%;
  }
  .hero-dot-fill.is-filled {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: none !important;
    }
    .hero-video-element {
      transition: none !important;
      transform: none !important;
    }
    .hero-dot-fill {
      transition: none !important;
    }
  }
</style>

<script>
  const initHeroVideo = () => {
    const root = document.getElementById('hero-slides');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const slides = Array.from(root.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-dot'));
    const fills = Array.from(document.querySelectorAll<HTMLElement>('.hero-dot-fill'));
    const playPause = document.getElementById('hero-playpause');

    if (slides.length < 2 || !playPause) return;

    const iconPause = playPause.querySelector<HTMLElement>('.hero-icon-pause');
    const iconPlay = playPause.querySelector<HTMLElement>('.hero-icon-play');

    const slideMs = Number(root.dataset.slideMs) || 8000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0;
    let paused = reduceMotion;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const stopTimer = () => {
      if (timer) {
        clearTimeout(timer);
        timer = null;
      }
    };

    const playActiveVideo = (index: number) => {
      slides.forEach((slide, i) => {
        const video = slide.querySelector<HTMLVideoElement>('video');
        if (!video) return;

        if (i === index) {
          // Los videos no tienen pista de audio (se saca al comprimir), pero el
          // atributo `muted` va igual: sin el, los navegadores bloquean el
          // autoplay y el hero arranca congelado en el poster.
          video.muted = true;
          video.play().catch(() => {
            // Si el navegador igual bloquea el autoplay, queda el poster.
          });
        } else {
          video.pause();
        }
      });
    };

    const paintBars = () => {
      fills.forEach((fill, i) => {
        fill.classList.remove('is-running', 'is-filled');
        fill.style.transition = 'none';
        if (i < current) fill.classList.add('is-filled');
      });

      const active = fills[current];
      if (!active) return;
      if (paused) {
        active.classList.add('is-filled');
        return;
      }
      // Reflow forzado: sin esto el navegador agrupa el reset y el arranque en
      // un solo frame, y la barra salta al final en vez de llenarse.
      void active.offsetWidth;
      active.style.transition = `width ${slideMs}ms linear`;
      active.classList.add('is-running');
    };

    const scheduleNext = () => {
      stopTimer();
      if (paused) return;
      timer = setTimeout(() => goTo((current + 1) % slides.length), slideMs);
    };

    const goTo = (index: number) => {
      // Deactivate current
      slides[current]?.classList.remove('is-active');
      slides[current]?.setAttribute('aria-hidden', 'true');
      dots[current]?.classList.remove('is-active');
      dots[current]?.setAttribute('aria-current', 'false');

      current = index;

      slides[current]?.classList.add('is-active');
      slides[current]?.setAttribute('aria-hidden', 'false');
      dots[current]?.classList.add('is-active');
      dots[current]?.setAttribute('aria-current', 'true');

      paintBars();
      playActiveVideo(current);
      scheduleNext();
    };

    const setPaused = (value: boolean) => {
      paused = value;
      playPause.setAttribute('aria-pressed', String(value));
      playPause.setAttribute(
        'aria-label',
        value ? 'Reanudar el carrusel de videos' : 'Pausar el carrusel de videos'
      );
      iconPause?.classList.toggle('hidden', value);
      iconPlay?.classList.toggle('hidden', !value);

      if (paused) {
        slides[current]?.querySelector<HTMLVideoElement>('video')?.pause();
        stopTimer();
      } else {
        playActiveVideo(current);
        scheduleNext();
      }
      paintBars();
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goTo(i));
    });

    playPause.addEventListener('click', () => setPaused(!paused));

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        slides.forEach(slide => slide.querySelector<HTMLVideoElement>('video')?.pause());
        stopTimer();
      } else if (!paused) {
        playActiveVideo(current);
        scheduleNext();
      }
    });

    // Start initial video
    paintBars();
    playActiveVideo(0);
    if (!paused) scheduleNext();
  };

  document.addEventListener('DOMContentLoaded', initHeroVideo);
  document.addEventListener('astro:page-load', initHeroVideo);
</script>
