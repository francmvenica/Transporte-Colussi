---
import { STATS } from '../config/stats';

// Nota interna (no publicar en el HTML) — grilla de tarjetas de estadísticas:
// grilla: 2 columnas en mobile, 4 en desktop. Los valores van en texto plano
// (no imagen, no oculto) para que los motores de búsqueda e IA los lean
// igual que un visitante. Ícono arriba de cada tarjeta: con una sola tarjeta
// ilustrada (el pedido explícito era un globo para la de la vuelta a la
// tierra) las otras 3 quedaban desbalanceadas, así que las 4 llevan ícono
// para que la sección se lea coherente.
//
// <section id="numeros">: va sobre fondo oscuro para separarse visualmente de
// "Quiénes Somos" (bg-neutral-100, justo antes) y de RRHH (bg-white, justo
// después). Los números viven en config/stats.ts, no acá.
//
// El H2 dice "la operación" y no "el servicio" (28/07): con "el servicio"
// chocaba con el H2 de la sección siguiente, "Nuestros Servicios", y la
// palabra aparecía dos veces con dos sentidos distintos a pocos scrolls. Se
// cambió ESTE y no aquel a propósito: "Nuestros Servicios" es el H2 que lleva
// el término por el que la gente busca, y moverlo tiene costo de
// posicionamiento. Acá la palabra no aportaba nada.
---

<section id="numeros" class="py-20 lg:py-28 bg-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">
        Trayectoria
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-display">
        Números que respaldan la operación
      </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-6">
      {STATS.map((stat) => (
        <div class="text-center px-2">
          <div class="w-12 h-12 rounded-full bg-brand-red/15 flex items-center justify-center mx-auto mb-4">
            {stat.icon === 'Flag' && (
              <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0l2.77-.693a9 9 0 016.208.682l.108.054a9 9 0 006.086.71l3.114-.732a48.524 48.524 0 01-.005-10.499l-3.114.732a9 9 0 01-6.085-.711l-.108-.054a9 9 0 00-6.208-.682L3 4.5M3 15V4.5" />
              </svg>
            )}
            {stat.icon === 'CheckCircle' && (
              <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {stat.icon === 'Globe' && (
              <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            )}
            {stat.icon === 'Calendar' && (
              <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
            )}
          </div>
          <p class={`font-extrabold text-brand-red mb-3 font-data ${stat.valueSize === 'phrase' ? 'text-2xl sm:text-3xl' : 'text-4xl sm:text-5xl'}`}>
            {stat.value}
          </p>
          <p class="text-sm text-neutral-300 leading-snug max-w-[220px] mx-auto">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
