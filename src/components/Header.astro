---
import { SITE } from '../config/site';

// BASE_URL puede venir sin slash final (p. ej. "/Transporte-Colussi") — se normaliza
// para que `${base}${href}` nunca pegue el path con lo que sigue.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// Notas internas (no publicar en el HTML):
//
// Nav de desktop: se arma desde SITE.nav (6 ítems) + el link a /historia.
// Nunca hardcodear la lista en el markup.
//
// <header id="site-header">: header fijo, ancho completo, pegado al borde
// superior (pedido de Franco, 27/07: la versión "píldora" flotante distraía
// a la vista). Se mantiene el fondo oscuro translúcido + backdrop-blur; se
// saca el margen superior (top-4), el ancho acotado centrado (max-w-5xl) y
// el rounded-full. Como ahora ocupa todo el ancho, ya no hace falta el
// truco de pointer-events-none/auto que tenía la píldora (existía solo para
// dejar pasar clicks por los costados, donde no había barra). scroll-padding-top
// en global.css está calculado contra la altura real de esta barra
// (h-16 = 4rem): si esa altura cambia acá, hay que ajustarlo ahí también (y
// el pt-* del primer section de historia.astro, que compensa lo mismo para
// una carga de página completa en vez de un scroll por ancla).
//
// Link/badge "TC" (isotipo, dentro de <header>): PROVISORIO, isotipo TC hasta
// que el cliente mande el logo PNG oficial. NO es la marca real, no
// propagarlo a otros lados. El footer sigue con el logo real sin tocar
// (Footer.astro / Logo.astro no cambiaron). El wordmark real necesitaba un
// chip blanco detrás para leerse sobre este fondo oscuro (el "Colussi" en
// negro se perdía); el badge TC en rojo de marca ya tiene contraste propio
// contra el header y no necesita ese chip.
//
// <div id="mobile-menu">: panel a todo lo ancho, pegado debajo de la barra
// (ya no flota separado con margen propio, porque el header dejó de ser una
// píldora).
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 bg-neutral-950/80 backdrop-blur-md border-b border-neutral-700/60 shadow-lg shadow-black/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={base} class="flex items-center shrink-0" aria-label="Transporte Colussi - Inicio">
        <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-brand-red text-white font-display text-base tracking-tight select-none">
          TC
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-5 xl:gap-6" aria-label="Navegación principal">
        {SITE.nav.map((item) => (
          <a
            href={`${base}${item.href}`}
            class="text-sm font-semibold text-neutral-300 hover:text-white transition-colors duration-200"
          >
            {item.label}
          </a>
        ))}
        <a
          href={`${base}historia`}
          class="text-sm font-semibold text-neutral-300 hover:text-white transition-colors duration-200"
        >
          Historia
        </a>
        <a
          href={SITE.whatsapp.link}
          target="_blank"
          rel="noopener noreferrer"
          class="header-cta inline-flex items-center px-4 py-2 bg-brand-red text-white text-sm font-semibold rounded-full hover:bg-brand-red-dark hover:scale-105 transition-all duration-200"
        >
          Solicitar Cotización
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-full hover:bg-white/10 transition-colors shrink-0"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-700/60 bg-neutral-950/95 backdrop-blur-xl shadow-xl shadow-black/30">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col gap-1" aria-label="Navegación móvil">
      {SITE.nav.map((item) => (
        <a
          href={`${base}${item.href}`}
          class="mobile-nav-link block px-4 py-3 text-neutral-200 font-medium rounded-2xl hover:bg-white/10 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={`${base}historia`}
        class="mobile-nav-link block px-4 py-3 text-neutral-200 font-medium rounded-2xl hover:bg-white/10 transition-colors"
      >
        Nuestra Historia
      </a>
      <a
        href={SITE.whatsapp.link}
        target="_blank"
        rel="noopener noreferrer"
        class="header-cta mobile-nav-link mt-2 block text-center px-4 py-3 bg-brand-red text-white font-semibold rounded-full hover:bg-brand-red-dark transition-colors"
      >
        Solicitar Cotización
      </a>
    </nav>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: reduce) {
    #site-header a,
    #site-header button {
      transition-duration: 0.01ms !important;
    }
    #site-header .header-cta:hover {
      transform: none !important;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const hamburger = document.getElementById('hamburger-icon')!;
  const closeIcon = document.getElementById('close-icon')!;

  // Mobile menu toggle
  let open = false;
  btn.addEventListener('click', () => {
    open = !open;
    menu.classList.toggle('hidden', !open);
    hamburger.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  });

  // Close mobile menu on link click
  menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      menu.classList.add('hidden');
      hamburger.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });
  });
</script>
