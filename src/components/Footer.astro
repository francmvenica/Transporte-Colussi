---
import { SITE } from '../config/site';
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

// Nota interna (no publicar en el HTML):
//
// El logo va en variante `reverse` y SIN el chip blanco que tenía antes. Ese
// chip (bg-white px-3 py-1 rounded shadow) era un parche: el logo viejo tenía
// el "Colussi" en negro y sobre este fondo oscuro se perdía, así que se le
// metía una cajita blanca detrás. Con la versión reverse oficial el parche
// sobra — y se veía como un remiendo pegado sobre el footer.
//
// 🔎 REVISADO EL 08/08: Romualdo dijo en la reunión "este logo no es, es
// distinto, más inclinado, más largo". Verificado: acá y en Header.astro se
// usa EL MISMO archivo oficial (logo-colussi-horizontal-reverse.png, llegado
// el 27/07 de manos del cliente) con `h-7 w-auto` — una sola dimensión fija,
// la otra en `auto`, que es exactamente el patrón que preserva el ratio
// 13,75:1 sin estirar (ver Logo.astro). No hay deformación de CSS de nuestro
// lado, ni acá ni en el header. Si el logo publicado sigue sin coincidir con
// lo que el cliente espera, el archivo que tenemos puede no ser la versión
// que él tiene en mente — es un dato a confirmar con Romualdo/Juan Manuel,
// no algo que se arregle tocando el markup.
//
// ⛔ SALIÓ EL BLOQUE "SEGUINOS" CON EL ÍCONO DE FACEBOOK (14/09). La cuenta
// está abandonada y el sitio invitaba a seguirla. La columna queda con
// "Trabajá con nosotros", que pasa a ser su título. Para reponerlo, ver la
// nota en config/site.ts.
// BASE_URL puede venir sin slash final (p. ej. "/Transporte-Colussi") — se normaliza
// para que `${base}${href}` nunca pegue el path con lo que sigue.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<footer class="bg-neutral-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div class="lg:col-span-1">
        <a href={base} class="inline-flex items-center mb-5" aria-label="Transporte Colussi - Inicio">
          <Logo variant="reverse" class="h-7 w-auto" />
        </a>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Transporte de cargas completas nacionales e internacionales. Logística y distribución en el NEA.
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-neutral-400 mb-4">Navegación</h3>
        <ul class="space-y-3">
          {SITE.nav.map((item) => (
            <li>
              <a href={`${base}${item.href}`} class="text-neutral-300 hover:text-white transition-colors text-sm">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`${base}historia`} class="text-neutral-300 hover:text-white transition-colors text-sm">
              Nuestra Historia
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-neutral-400 mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={`mailto:${SITE.contact.email}`} class="text-neutral-300 hover:text-white transition-colors">
              {SITE.contact.email}
            </a>
          </li>
          <li>
            <a href={`tel:${SITE.contact.phoneRaw}`} class="text-neutral-300 hover:text-white transition-colors font-data">
              {SITE.contact.phone}
            </a>
          </li>
          <li class="text-neutral-400">{SITE.sedes[0].address}</li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-neutral-400 mb-4">Trabajá con nosotros</h3>
        <a href={`mailto:${SITE.contact.email}`} class="text-sm text-neutral-300 hover:text-brand-red transition-colors">
          Enviá tu CV →
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <p class="text-center text-sm text-neutral-500">
        © {currentYear} {SITE.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
